          "name": "Submit Application (POST /api/applications)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 2,\n  \"job_posting_id\": 3,\n  \"resume_url\": \"https://drive.google.com/resume/alumni-2\",\n  \"cover_letter\": \"I am enthusiastic about scalable backend architecture.\"\n}"

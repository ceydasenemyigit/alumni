      "name": "1. Job Postings (Valid CRUD)",
      "item": [
        {
          "name": "List All Jobs (GET /api/jobs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] }
          }
        },
        {
          "name": "Create Job - Valid with Optional City (POST /api/jobs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Cloud Native DevOps Engineer\",\n  \"company\": \"Apex Cloud Ltd.\",\n  \"city\": \"Izmir\",\n  \"employment_type\": \"Remote\",\n  \"description\": \"Responsible for Kubernetes cluster management and CI/CD pipelines.\",\n  \"salary_range\": \"$75,000 - $95,000\",\n  \"posted_by_user_id\": 1\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] }
          }
        },
        {
          "name": "Create Job - Without Optional Description (POST /api/jobs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Junior QA Automation Tester\",\n  \"company\": \"FinTech Horizon\",\n  \"city\": \"Istanbul\",\n  \"employment_type\": \"Full-Time\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/jobs", "host": ["{{baseUrl}}"], "path": ["api", "jobs"] }

{
  "openapi": "3.0.3",
  "info": {
    "title": "Alumni Tracking System API & Web Directory",
    "version": "1.2.0",
    "description": "Complete documentation for the Alumni Tracking System featuring MVC Web Views (/users, /announcements) and RESTful JSON APIs (/api/users, /api/announcements), developed for the Web Programming course at Istanbul University."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "Announcements (MVC Web Views)",
      "description": "Server-side rendered HTML views under /announcements"
    },
    {
      "name": "Announcements (REST API)",
      "description": "JSON API endpoints under /api/announcements"
    },
    {
      "name": "Users (MVC Web Views)",
      "description": "Server-side rendered HTML views under /users"
    },
    {
      "name": "Users (REST API)",
      "description": "JSON API endpoints under /api/users"
    },
    {
      "name": "System",
      "description": "Health checks and system diagnostics"
    },
    {
      "name": "Introductory Routes",
      "description": "Basic Express introductory routes"
    }
  ],
  "paths": {
    "/announcements": {
      "get": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Announcements Listing View (HTML)",
        "description": "Renders the HTML table view listing all announcements. Supports search and category filtering.",
        "parameters": [
          { "name": "search", "in": "query", "description": "Search in title, content, or author", "schema": { "type": "string" } },
          { "name": "category", "in": "query", "description": "Filter by category", "schema": { "type": "string", "enum": ["Event", "Career", "Academic", "General"] } }
        ],
        "responses": {
          "200": { "description": "HTML web page with announcement list", "content": { "text/html": {} } }
        }
      },
      "post": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Publish Announcement via Web Form",
        "description": "Receives announcement creation form data, creates the announcement in-memory, and redirects to the detail view.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/AnnouncementInput" }
            }
          }
        },
        "responses": {
          "302": { "description": "Redirects to /announcements/{id} on success" },
          "400": { "description": "Re-renders form with validation error", "content": { "text/html": {} } }
        }
      }
    },
    "/announcements/new": {
      "get": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Render Announcement Creation Form (HTML)",
        "description": "Renders the HTML form page to publish a new announcement.",
        "responses": {
          "200": { "description": "HTML announcement creation form", "content": { "text/html": {} } }
        }
      }
    },
    "/announcements/{id}": {
      "get": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Announcement Details View (HTML)",
        "description": "Renders the detailed view of a specific announcement.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "HTML announcement details page", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (Announcement not found)", "content": { "text/html": {} } }
        }
      },
      "put": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Update Announcement via Web Form",
        "description": "Handles update from the edit form (supports _method=PUT or direct POST).",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/AnnouncementInput" }
            }
          }
        },
        "responses": {
          "302": { "description": "Redirects to /announcements/{id} on success" },
          "400": { "description": "Re-renders edit form with validation error", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (Announcement not found)", "content": { "text/html": {} } }
        }
      },
      "delete": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Delete Announcement via Web Form",
        "description": "Handles announcement deletion from web form.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "302": { "description": "Redirects to /announcements on success" },
          "404": { "description": "HTML error page (Announcement not found)", "content": { "text/html": {} } }
        }
      }
    },
    "/announcements/{id}/edit": {
      "get": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Render Announcement Edit Form (HTML)",
        "description": "Renders the HTML form page to edit an existing announcement.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "HTML announcement edit form", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (Announcement not found)", "content": { "text/html": {} } }
        }
      }
    },
    "/announcements/{id}/delete": {
      "post": {
        "tags": ["Announcements (MVC Web Views)"],
        "summary": "Delete Announcement Fallback (POST)",
        "description": "Handles HTML button form submission to remove an announcement.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "302": { "description": "Redirects to /announcements on success" }
        }
      }
    },
    "/api/announcements": {
      "get": {
        "tags": ["Announcements (REST API)"],
        "summary": "List all announcements (JSON)",
        "description": "Returns a list of announcements stored in memory. Supports query filters.",
        "parameters": [
          { "name": "category", "in": "query", "description": "Filter by category (e.g. Event, Career)", "schema": { "type": "string" } },
          { "name": "author", "in": "query", "description": "Filter by author substring", "schema": { "type": "string" } },
          { "name": "search", "in": "query", "description": "Search keyword across title, content, author, category", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of announcements",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AnnouncementListResponse" }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Announcements (REST API)"],
        "summary": "Create announcement (JSON / Form)",
        "description": "Creates a new announcement. Supports JSON, URL-Encoded, and Multipart formats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "Announcement created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Announcement" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error (missing title or content)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } }
          }
        }
      }
    },
    "/api/announcements/{id}": {
      "get": {
        "tags": ["Announcements (REST API)"],
        "summary": "Get announcement by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Announcement found",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementResponse" } } }
          },
          "400": { "description": "Invalid ID format", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Announcement not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "tags": ["Announcements (REST API)"],
        "summary": "Full update announcement by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Announcement updated",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementResponse" } } }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Announcement not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "patch": {
        "tags": ["Announcements (REST API)"],
        "summary": "Partial update announcement by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/AnnouncementInput" } }
          }
        },
        "responses": {
          "200": {
            "description": "Announcement patched",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AnnouncementResponse" } } }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Announcement not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Announcements (REST API)"],
        "summary": "Delete announcement by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Announcement deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/Announcement" }
                  }
                }
              }
            }
          },
          "400": { "description": "Invalid ID format", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "404": { "description": "Announcement not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/users": {
      "get": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "User Listing View (HTML)",
        "description": "Renders the HTML table view listing all registered alumni and students. Supports search and role filtering.",
        "parameters": [
          { "name": "search", "in": "query", "description": "Search keyword", "schema": { "type": "string" } },
          { "name": "role", "in": "query", "description": "Filter by role", "schema": { "type": "string", "enum": ["STUDENT", "ALUMNI", "ADMIN"] } }
        ],
        "responses": {
          "200": { "description": "HTML web page with user list", "content": { "text/html": {} } }
        }
      },
      "post": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Create User via Web Form",
        "description": "Receives user creation form data, creates the user in-memory, and redirects to the user's profile view.",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "302": { "description": "Redirects to /users/{id} on success" },
          "400": { "description": "Re-renders form with validation error", "content": { "text/html": {} } }
        }
      }
    },
    "/users/new": {
      "get": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Render User Creation Form (HTML)",
        "description": "Renders the HTML form page to create a new user.",
        "responses": {
          "200": { "description": "HTML user creation form", "content": { "text/html": {} } }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "User Details View (HTML)",
        "description": "Renders the detailed profile view of a specific user.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "HTML user profile page", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (User not found)", "content": { "text/html": {} } }
        }
      },
      "put": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Update User via Web Form",
        "description": "Handles full update from the edit form (supports _method=PUT or direct POST).",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "302": { "description": "Redirects to /users/{id} on success" },
          "400": { "description": "Re-renders form with validation error", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (User not found)", "content": { "text/html": {} } }
        }
      },
      "delete": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Delete User via Web Form",
        "description": "Handles user deletion from the web profile or table.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "302": { "description": "Redirects to /users on success" },
          "404": { "description": "HTML error page (User not found)", "content": { "text/html": {} } }
        }
      }
    },
    "/users/{id}/edit": {
      "get": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Render User Edit Form (HTML)",
        "description": "Renders the HTML form page to edit an existing user.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "HTML user edit form", "content": { "text/html": {} } },
          "404": { "description": "HTML error page (User not found)", "content": { "text/html": {} } }
        }
      }
    },
    "/users/{id}/delete": {
      "post": {
        "tags": ["Users (MVC Web Views)"],
        "summary": "Delete User Fallback (POST)",
        "description": "Handles HTML button form submission to remove a user.",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "302": { "description": "Redirects to /users on success" }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": ["Users (REST API)"],
        "summary": "List all users (JSON)",
        "description": "Returns a list of users stored in memory. Supports role and search filtering.",
        "parameters": [
          { "name": "role", "in": "query", "description": "Filter by role", "schema": { "type": "string", "enum": ["STUDENT", "ALUMNI", "ADMIN"] } },
          { "name": "search", "in": "query", "description": "Search keyword", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "count": { "type": "integer", "example": 3 },
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/User" } }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Users (REST API)"],
        "summary": "Create user (JSON / Form)",
        "description": "Creates a new user. Supports JSON, URL-Encoded, and Multipart formats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/UserInput" } }
          }
        },
        "responses": {
          "201": {
            "description": "User created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": { "description": "Validation error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "409": { "description": "Email conflict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/users/{id}": {
      "get": {
        "tags": ["Users (REST API)"],
        "summary": "Get user by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "User found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "put": {
        "tags": ["Users (REST API)"],
        "summary": "Full update user by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/UserInput" } }
          }
        },
        "responses": {
          "200": { "description": "User updated", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "patch": {
        "tags": ["Users (REST API)"],
        "summary": "Partial update user by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UserPatchInput" } },
            "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/UserPatchInput" } }
          }
        },
        "responses": {
          "200": { "description": "User patched", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/UserResponse" } } } },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "delete": {
        "tags": ["Users (REST API)"],
        "summary": "Delete user by ID (JSON)",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "User deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "example": true },
                    "message": { "type": "string" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "404": { "description": "User not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": ["System"],
        "summary": "Application health check and diagnostics",
        "responses": {
          "200": {
            "description": "Application status UP",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/HealthResponse" } }
            }
          }
        }
      }
    },
    "/hello": {
      "get": {
        "tags": ["Introductory Routes"],
        "summary": "Returns Hello World greeting",
        "responses": { "200": { "description": "Returns 'Hello World'" } }
      }
    },
    "/hello/{name}": {
      "get": {
        "tags": ["Introductory Routes"],
        "summary": "Personalized greeting",
        "parameters": [
          { "name": "name", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Returns 'Hello {Name}!'" } }
      }
    },
    "/sum/{number1}/{number2}": {
      "get": {
        "tags": ["Introductory Routes"],
        "summary": "Sum of two numbers",
        "parameters": [
          { "name": "number1", "in": "path", "required": true, "schema": { "type": "number" } },
          { "name": "number2", "in": "path", "required": true, "schema": { "type": "number" } }
        ],
        "responses": { "200": { "description": "Calculated sum" } }
      }
    },
    "/about": {
      "get": {
        "tags": ["Introductory Routes"],
        "summary": "About project page",
        "responses": { "200": { "description": "About HTML page" } }
      }
    }
  },
  "components": {
    "schemas": {
      "Announcement": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "title": { "type": "string", "example": "Annual Alumni Homecoming 2026" },
          "content": { "type": "string", "example": "Join us for the annual gathering on campus..." },
          "author": { "type": "string", "example": "Alumni Relations Office" },
          "category": { "type": "string", "example": "Event" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "AnnouncementInput": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string", "example": "Annual Alumni Homecoming 2026" },
          "content": { "type": "string", "example": "Join us for the annual gathering on campus..." },
          "author": { "type": "string", "example": "Alumni Relations Office" },
          "category": { "type": "string", "example": "Event" }
        }
      },
      "AnnouncementResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/Announcement" }
        }
      },
      "AnnouncementListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "count": { "type": "integer", "example": 3 },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Announcement" }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "example": 1 },
          "email": { "type": "string", "format": "email", "example": "emre@example.com" },
          "first_name": { "type": "string", "example": "Emre" },
          "last_name": { "type": "string", "example": "Yılmaz" },
          "role": { "type": "string", "enum": ["STUDENT", "ALUMNI", "ADMIN"], "example": "ALUMNI" },
          "department": { "type": "string", "example": "Computer Engineering" },
          "graduation_year": { "type": "integer", "example": 2024 },
          "is_verified": { "type": "boolean", "example": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": { "type": "string", "format": "email", "example": "ahmet@example.com" },
          "first_name": { "type": "string", "example": "Ahmet" },
          "last_name": { "type": "string", "example": "Kaya" },
          "role": { "type": "string", "enum": ["STUDENT", "ALUMNI", "ADMIN"], "default": "ALUMNI" },
          "department": { "type": "string", "example": "Computer Engineering" },
          "graduation_year": { "type": "integer", "example": 2024 }
        }
      },
      "UserPatchInput": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string", "example": "Ahmet Can" },
          "department": { "type": "string", "example": "Software Engineering" },
          "graduation_year": { "type": "integer", "example": 2025 }
        }
      },
      "UserResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "data": { "$ref": "#/components/schemas/User" }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "UP" },
          "timestamp": { "type": "string", "format": "date-time" },
          "uptime": { "type": "object" },
          "system": { "type": "object" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "Validation Error" },
          "message": { "type": "string", "example": "Gerekli alanlar eksik veya hatalı." }
        }
      }
    }
  }
}

<%- include('partials/header') %>

<div style="max-width: 680px; margin: 48px auto; text-align: center;">
  <div class="card" style="padding: 56px 40px; box-shadow: var(--shadow-apple); border-color: rgba(244, 63, 94, 0.35);">
    <div style="display: inline-flex; align-items: center; justify-content: center; width: 80px; height: 80px; border-radius: 9999px; background: rgba(244, 63, 94, 0.15); border: 2px solid rgba(244, 63, 94, 0.4); font-size: 2.5rem; margin-bottom: 24px; box-shadow: 0 4px 20px rgba(244, 63, 94, 0.25);">
      🔍
    </div>

    <div style="margin-bottom: 14px;">
      <span class="badge badge-rejected" style="font-size: 0.82rem; padding: 6px 14px;">
        🛡️ 404 GUARDIAN &bull; RESOURCE NOT FOUND
      </span>
    </div>

    <h1 style="font-size: 2.4rem; font-weight: 800; color: white; margin-bottom: 12px; letter-spacing: -0.03em;">
      <%= typeof title !== 'undefined' ? title : 'Page Not Found' %>
    </h1>

    <div style="background: rgba(20, 12, 23, 0.65); border: 1px solid rgba(244, 63, 94, 0.25); border-radius: 14px; padding: 18px 22px; margin: 24px 0; text-align: left;">
      <div style="color: var(--text-soft); font-size: 0.76rem; margin-bottom: 6px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em;">DIAGNOSTIC REASON:</div>
      <div style="color: #fecdd3; font-size: 0.98rem; line-height: 1.6; font-weight: 500;">
        <%= typeof reason !== 'undefined' ? reason : 'The requested resource or endpoint is not defined on this server.' %>
      </div>
      <% if (typeof path !== 'undefined' && path) { %>
        <div style="margin-top: 10px; font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; color: var(--text-soft); padding-top: 8px; border-top: 1px solid rgba(255, 255, 255, 0.06);">
          <span>Target URI:</span> <span style="color: var(--primary-on-dark);"><%= path %></span>
        </div>
      <% } %>
    </div>

    <p style="color: var(--text-muted); font-size: 0.96rem; line-height: 1.7; margin-bottom: 32px;">
      The route you attempted to access may have been moved, renamed, or is currently unavailable. Return to verified platform modules:
    </p>

    <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
      <a href="/" class="btn btn-pill btn-pill-primary btn-sm">🏠 Home Portal</a>
      <a href="/users" class="btn btn-utility btn-sm">👥 Alumni Directory</a>
      <a href="/jobs" class="btn btn-utility btn-sm">💼 Job Board</a>
      <a href="/applications" class="btn btn-utility btn-sm">📝 Applications</a>
      <a href="/announcements" class="btn btn-utility btn-sm">📢 Announcements</a>
      <a href="/api/swagger" class="btn btn-utility btn-sm" target="_blank">📚 Swagger API</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Announcements & Notices</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Stay updated with official alumni gatherings, career opportunities, and campus events.</p>
  </div>
  <a href="/announcements/new" class="btn btn-primary">+ Publish Announcement</a>
</div>

<div class="card" style="margin-bottom: 24px;">
  <form action="/announcements" method="GET" style="display: flex; gap: 12px; flex-wrap: wrap;">
    <input
      type="text"
      name="search"
      value="<%= search %>"
      placeholder="Search by title, content, or author..."
      style="flex: 1; min-width: 240px; padding: 10px 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 8px; color: white; font-size: 0.9rem;"
    >
    <select name="category" style="padding: 10px 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 8px; color: white; font-size: 0.9rem;">
      <option value="">All Categories</option>
      <option value="Event" <%= activeCategory.toLowerCase() === 'event' ? 'selected' : '' %>>Event</option>
      <option value="Career" <%= activeCategory.toLowerCase() === 'career' ? 'selected' : '' %>>Career</option>
      <option value="Academic" <%= activeCategory.toLowerCase() === 'academic' ? 'selected' : '' %>>Academic</option>
      <option value="General" <%= activeCategory.toLowerCase() === 'general' ? 'selected' : '' %>>General</option>
    </select>
    <button type="submit" class="btn btn-outline">Filter</button>
    <% if (search || activeCategory) { %>
      <a href="/announcements" class="btn btn-outline" style="color: var(--text-muted);">Reset</a>
    <% } %>
  </form>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <% if (announcements.length === 0) { %>
    <div style="padding: 48px 24px; text-align: center; color: var(--text-muted);">
      <p style="font-size: 1.1rem; margin-bottom: 12px;">No announcements found matching your criteria.</p>
      <a href="/announcements/new" class="btn btn-primary btn-sm">Create the first announcement</a>
    </div>
  <% } else { %>
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border); background: rgba(15, 23, 42, 0.4); color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <th style="padding: 14px 20px;">ID</th>
          <th style="padding: 14px 20px;">Title</th>
          <th style="padding: 14px 20px;">Category</th>
          <th style="padding: 14px 20px;">Author</th>
          <th style="padding: 14px 20px;">Date</th>
          <th style="padding: 14px 20px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% announcements.forEach(item => { %>
          <tr style="border-bottom: 1px solid rgba(51, 65, 85, 0.4); transition: background 0.15s;" onmouseover="this.style.background='rgba(51,65,85,0.2)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 16px 20px; font-family: monospace; color: var(--text-muted);">#<%= item.id %></td>
            <td style="padding: 16px 20px; font-weight: 600; color: white;">
              <a href="/announcements/<%= item.id %>" style="color: white; text-decoration: none;">
                <%= item.title %>
              </a>
            </td>
            <td style="padding: 16px 20px;">
              <span class="badge badge-<%= (item.category || 'general').toLowerCase() %>"><%= item.category %></span>
            </td>
            <td style="padding: 16px 20px; color: var(--text-muted);"><%= item.author %></td>
            <td style="padding: 16px 20px; color: var(--text-muted); font-size: 0.85rem;"><%= new Date(item.createdAt).toLocaleDateString() %></td>
            <td style="padding: 16px 20px; text-align: right;">
              <div style="display: inline-flex; gap: 8px;">
                <a href="/announcements/<%= item.id %>" class="btn btn-outline btn-sm">View</a>
                <a href="/announcements/<%= item.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                <form action="/announcements/<%= item.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this announcement?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>

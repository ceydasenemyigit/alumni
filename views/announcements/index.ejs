<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Announcements & Notices</h1>
    <p class="page-subtitle">Stay informed on university gatherings, homecoming events, academic seminars, and career initiatives.</p>
  </div>
  <a href="/announcements/new" class="btn btn-pill btn-pill-primary">+ Broadcast Notice</a>
</div>

<!-- Search & Category Filters -->
<div class="card" style="margin-bottom: 28px; padding: 18px 24px;">
  <form action="/announcements" method="GET" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
    <div style="flex: 1; min-width: 260px; position: relative;">
      <input
        type="text"
        name="search"
        value="<%= search %>"
        placeholder="Search notices by title, content, or author..."
        class="form-control"
        style="padding-left: 42px;"
      >
      <span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-soft); font-size: 1.05rem;">📢</span>
    </div>
    <select name="category" class="form-control" style="width: auto; min-width: 170px;">
      <option value="">All Categories</option>
      <option value="Event" <%= activeCategory.toLowerCase() === 'event' ? 'selected' : '' %>>🎉 Event</option>
      <option value="Career" <%= activeCategory.toLowerCase() === 'career' ? 'selected' : '' %>>💼 Career</option>
      <option value="Academic" <%= activeCategory.toLowerCase() === 'academic' ? 'selected' : '' %>>🎓 Academic</option>
      <option value="General" <%= activeCategory.toLowerCase() === 'general' ? 'selected' : '' %>>📌 General</option>
    </select>
    <button type="submit" class="btn btn-utility">Filter Notices</button>
    <% if (search || activeCategory) { %>
      <a href="/announcements" class="btn btn-utility" style="color: var(--text-soft);">Reset</a>
    <% } %>
  </form>
</div>

<!-- Announcements Table -->
<div class="table-container">
  <% if (announcements.length === 0) { %>
    <div style="padding: 64px 24px; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 12px; opacity: 0.7;">📢</div>
      <h3 style="color: white; font-size: 1.3rem; margin-bottom: 6px;">No Announcements Found</h3>
      <p style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text-soft);">Publish a campus event or career update for the community.</p>
      <a href="/announcements/new" class="btn btn-pill btn-pill-primary btn-sm">+ Publish First Notice</a>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Notice Title</th>
          <th>Category</th>
          <th>Author / Publisher</th>
          <th>Published Date</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% announcements.forEach(item => { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                  <%= item.category === 'Event' ? '🎉' : (item.category === 'Career' ? '💼' : (item.category === 'Academic' ? '🎓' : '📢')) %>
                </div>
                <div>
                  <a href="/announcements/<%= item.id %>" style="color: white; font-weight: 700; text-decoration: none; font-size: 1rem; display: block; transition: color 0.2s;" onmouseover="this.style.color='#fda4af'" onmouseout="this.style.color='white'">
                    <%= item.title %>
                  </a>
                  <span style="font-size: 0.78rem; color: var(--text-soft); font-family: 'JetBrains Mono', monospace;">ID #ANN-<%= item.id %></span>
                </div>
              </div>
            </td>
            <td>
              <span class="badge badge-<%= (item.category || 'general').toLowerCase() %>"><%= item.category %></span>
            </td>
            <td>
              <span style="color: white; font-weight: 500;"><%= item.author %></span>
            </td>
            <td>
              <span style="color: var(--text-muted); font-size: 0.88rem;"><%= new Date(item.createdAt).toLocaleDateString() %></span>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px; align-items: center;">
                <a href="/announcements/<%= item.id %>" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Read</a>
                <a href="/announcements/<%= item.id %>/edit" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Edit</a>
                <form action="/announcements/<%= item.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Permanently remove this announcement?');">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>

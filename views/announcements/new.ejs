<%- include('../partials/header') %>

<div style="max-width: 740px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <h1 class="page-title">Publish New Announcement</h1>
      <p class="page-subtitle">Share official university notices, homecoming gatherings, or academic initiatives.</p>
    </div>
    <a href="/announcements" class="btn btn-utility">&larr; Notices Board</a>
  </div>

  <% if (error) { %>
    <div class="alert-error">
      <span style="font-size: 1.2rem;">⚠️</span>
      <div>
        <strong>Publishing Error:</strong> <%= error %>
      </div>
    </div>
  <% } %>

  <div class="card" style="box-shadow: var(--shadow-apple);">
    <form action="/announcements" method="POST">
      <div class="form-group">
        <label class="form-label">Notice Headline *</label>
        <input
          type="text"
          name="title"
          value="<%= formData.title || '' %>"
          placeholder="e.g. Annual Homecoming & Alumni Networking Gala 2026"
          required
          class="form-control"
        >
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group">
          <label class="form-label">Category</label>
          <select name="category" class="form-control">
            <option value="Event" <%= (formData.category === 'Event' || !formData.category) ? 'selected' : '' %>>🎉 Event</option>
            <option value="Career" <%= formData.category === 'Career' ? 'selected' : '' %>>💼 Career</option>
            <option value="Academic" <%= formData.category === 'Academic' ? 'selected' : '' %>>🎓 Academic</option>
            <option value="General" <%= formData.category === 'General' ? 'selected' : '' %>>📌 General</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Author / Publishing Office</label>
          <input
            type="text"
            name="author"
            value="<%= formData.author || '' %>"
            placeholder="e.g. Alumni Relations Office"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Announcement Content *</label>
        <textarea
          name="content"
          rows="6"
          placeholder="Detailed agenda, speaker lineup, attendance prerequisites, or registration links..."
          required
          class="form-control"
        ><%= formData.content || '' %></textarea>
      </div>

      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 14px; justify-content: flex-end; align-items: center;">
        <a href="/announcements" class="btn btn-utility">Cancel</a>
        <button type="submit" class="btn btn-pill btn-pill-primary">Publish Notice &rarr;</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>

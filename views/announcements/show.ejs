<%- include('../partials/header') %>

<div style="max-width: 760px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <h1 class="page-title"><%= announcement.title %></h1>
      <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Announcement #<%= announcement.id %></p>
    </div>
    <a href="/announcements" class="btn btn-outline">&larr; Back to Announcements</a>
  </div>

  <div class="card">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 16px; margin-bottom: 24px; flex-wrap: wrap; gap: 12px;">
      <div style="display: flex; align-items: center; gap: 12px;">
        <span class="badge badge-<%= (announcement.category || 'general').toLowerCase() %>"><%= announcement.category %></span>
        <span style="color: var(--text-muted); font-size: 0.9rem;">By <strong style="color: white;"><%= announcement.author %></strong></span>
      </div>
      <div>
        <a href="/announcements/<%= announcement.id %>/edit" class="btn btn-outline btn-sm">Edit Announcement</a>
      </div>
    </div>

    <div style="line-height: 1.7; font-size: 1.05rem; color: #e2e8f0; margin-bottom: 32px; white-space: pre-wrap;">
      <%= announcement.content %>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 16px; background: rgba(15, 23, 42, 0.4); border-radius: 8px; border: 1px solid var(--border); font-size: 0.85rem;">
      <div>
        <span style="color: var(--text-muted); display: block; margin-bottom: 2px;">Published</span>
        <span style="color: white; font-weight: 500;"><%= new Date(announcement.createdAt).toLocaleString() %></span>
      </div>
      <div>
        <span style="color: var(--text-muted); display: block; margin-bottom: 2px;">Last Modified</span>
        <span style="color: white; font-weight: 500;"><%= new Date(announcement.updatedAt).toLocaleString() %></span>
      </div>
    </div>

    <div style="margin-top: 32px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
      <form action="/announcements/<%= announcement.id %>/delete" method="POST" onsubmit="return confirm('Permanently delete this announcement?');">
        <button type="submit" class="btn btn-danger btn-sm">Delete Announcement</button>
      </form>
      <div style="display: flex; gap: 10px;">
        <a href="/api/announcements/<%= announcement.id %>" class="btn btn-outline btn-sm" target="_blank">View JSON</a>
        <a href="/announcements" class="btn btn-primary btn-sm">All Announcements</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>

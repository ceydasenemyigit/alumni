<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Job Applications & Candidate Pipeline</h1>
    <p class="page-subtitle">Track recruitment flows, evaluate candidate submissions, and manage the N:M graduate-to-job matching pipeline.</p>
  </div>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="/jobs" class="btn btn-utility">&larr; Job Board</a>
    <a href="/applications/new" class="btn btn-pill btn-pill-primary">+ Submit Application</a>
  </div>
</div>

<% if (typeof stats !== 'undefined' && stats) { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 14px; margin-bottom: 28px;">
    <div class="stat-card">
      <div class="stat-label">Total Submissions</div>
      <div class="stat-value"><%= stats.total %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Pending Review</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #fde68a, #f59e0b); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.pending %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Interview / In Review</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #7dd3fc, #0ea5e9); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.reviewing %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Accepted Offers</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #6ee7b7, #10b981); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.accepted %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Archived / Rejected</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #fecdd3, #f43f5e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.rejected %></div>
    </div>
  </div>
<% } %>

<!-- Filter Bar -->
<div class="card" style="margin-bottom: 28px; padding: 18px 24px;">
  <form action="/applications" method="GET" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
    <select name="status" class="form-control" style="flex: 1; min-width: 200px;">
      <option value="">All Application Statuses</option>
      <option value="PENDING" <%= query && query.status === 'PENDING' ? 'selected' : '' %>>⏳ PENDING</option>
      <option value="REVIEWING" <%= query && query.status === 'REVIEWING' ? 'selected' : '' %>>🔍 REVIEWING</option>
      <option value="ACCEPTED" <%= query && query.status === 'ACCEPTED' ? 'selected' : '' %>>✓ ACCEPTED</option>
      <option value="REJECTED" <%= query && query.status === 'REJECTED' ? 'selected' : '' %>>✕ REJECTED</option>
      <option value="WITHDRAWN" <%= query && query.status === 'WITHDRAWN' ? 'selected' : '' %>>↩ WITHDRAWN</option>
    </select>

    <% if (typeof jobs !== 'undefined' && jobs && jobs.length > 0) { %>
      <select name="job_posting_id" class="form-control" style="flex: 1.5; min-width: 240px;">
        <option value="">All Career Opportunities</option>
        <% jobs.forEach(j => { %>
          <option value="<%= j.id %>" <%= query && String(query.job_posting_id) === String(j.id) ? 'selected' : '' %>>
            <%= j.title %> &bull; <%= j.company %>
          </option>
        <% }) %>
      </select>
    <% } %>

    <button type="submit" class="btn btn-utility">Filter Pipeline</button>
    <% if (query && (query.status || query.job_posting_id)) { %>
      <a href="/applications" class="btn btn-utility" style="color: var(--text-soft);">Reset</a>
    <% } %>
  </form>
</div>

<!-- Applications Data Table -->
<div class="table-container">
  <% if (!applications || applications.length === 0) { %>
    <div style="padding: 64px 24px; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 12px; opacity: 0.7;">📝</div>
      <h3 style="color: white; font-size: 1.3rem; margin-bottom: 6px;">No Applications In Pipeline</h3>
      <p style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text-soft);">Submit an application for any open career opportunity.</p>
      <a href="/applications/new" class="btn btn-pill btn-pill-primary btn-sm">+ Submit New Application</a>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Application ID</th>
          <th>Applicant (Candidate)</th>
          <th>Position & Organization</th>
          <th>Current Status</th>
          <th>Submission Date</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% applications.forEach(app => { %>
          <tr>
            <td style="font-family: 'JetBrains Mono', monospace; color: var(--text-soft);">
              #APP-<%= app.id %>
            </td>
            <td>
              <% if (app.applicant) { %>
                <div style="display: flex; align-items: center; gap: 12px;">
                  <div style="width: 38px; height: 38px; border-radius: 9999px; background: rgba(244, 63, 94, 0.2); border: 1px solid rgba(244, 63, 94, 0.35); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; font-size: 0.9rem; flex-shrink: 0;">
                    <%= app.applicant.first_name ? app.applicant.first_name[0].toUpperCase() : 'U' %>
                  </div>
                  <div>
                    <a href="/users/<%= app.applicant.id %>" style="color: white; font-weight: 700; text-decoration: none; font-size: 0.96rem; display: block;">
                      <%= app.applicant.first_name %> <%= app.applicant.last_name %>
                    </a>
                    <span style="font-size: 0.8rem; color: var(--text-muted);"><%= app.applicant.email %></span>
                  </div>
                </div>
              <% } else { %>
                <span style="color: var(--text-muted);">Candidate #<%= app.user_id %></span>
              <% } %>
            </td>
            <td>
              <% if (app.job_posting) { %>
                <div>
                  <a href="/jobs/<%= app.job_posting.id %>" style="color: var(--primary-on-dark); text-decoration: none; font-weight: 700; font-size: 0.96rem; display: block;">
                    <%= app.job_posting.title %>
                  </a>
                  <span style="font-size: 0.82rem; color: var(--text-muted);"><%= app.job_posting.company %> &bull; <%= app.job_posting.location || 'Remote' %></span>
                </div>
              <% } else { %>
                <span style="color: var(--text-muted);">Job Vacancy #<%= app.job_posting_id %></span>
              <% } %>
            </td>
            <td>
              <span class="badge badge-<%= (app.status || 'pending').toLowerCase() %>"><%= app.status %></span>
            </td>
            <td>
              <span style="color: var(--text-muted); font-size: 0.85rem;"><%= new Date(app.applied_at).toLocaleDateString() %></span>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px; align-items: center;">
                <a href="/applications/<%= app.id %>" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Review</a>
                <a href="/applications/<%= app.id %>/edit" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Edit</a>
                <form action="/applications/<%= app.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to withdraw or delete this application?');">
                  <button type="submit" class="btn btn-danger">Withdraw</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>

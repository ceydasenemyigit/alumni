<%- include('../partials/header') %>

<div style="max-width: 860px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
        <h1 class="page-title">Application #<%= application.id %></h1>
        <span class="badge badge-<%= application.status.toLowerCase() %>" style="font-size: 0.85rem; padding: 6px 14px;">
          <%= application.status %>
        </span>
      </div>
      <p style="color: var(--text-muted); font-size: 0.95rem;">
        Submitted on <%= new Date(application.applied_at).toLocaleString('tr-TR') %>
        <% if (application.updated_at && application.updated_at !== application.applied_at) { %>
          &bull; Last updated <%= new Date(application.updated_at).toLocaleString('tr-TR') %>
        <% } %>
      </p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/applications" class="btn btn-outline btn-sm">&larr; Back to Applications</a>
      <a href="/applications/<%= application.id %>/edit" class="btn btn-outline btn-sm">Edit Application</a>
      <form action="/applications/<%= application.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to withdraw/delete this application?');">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  </div>

  <!-- Quick Status Workflow Bar -->
  <div class="card" style="margin-bottom: 24px; background: rgba(15, 23, 42, 0.5); padding: 16px 20px;">
    <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 10px;">
      Quick Review & Status Transition
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap; align-items: center;">
      <form action="/applications/<%= application.id %>/status" method="POST" style="display: inline;">
        <input type="hidden" name="status" value="PENDING">
        <button type="submit" class="btn btn-outline btn-sm" <%= application.status === 'PENDING' ? 'disabled style="opacity:0.5;"' : '' %>>
          Set Pending
        </button>
      </form>

      <form action="/applications/<%= application.id %>/status" method="POST" style="display: inline;">
        <input type="hidden" name="status" value="REVIEWING">
        <button type="submit" class="btn btn-outline btn-sm" style="border-color: #38bdf8; color: #38bdf8;" <%= application.status === 'REVIEWING' ? 'disabled style="opacity:0.5;"' : '' %>>
          Mark Under Review
        </button>
      </form>

      <form action="/applications/<%= application.id %>/status" method="POST" style="display: inline;">
        <input type="hidden" name="status" value="ACCEPTED">
        <button type="submit" class="btn btn-outline btn-sm" style="border-color: #34d399; color: #34d399;" <%= application.status === 'ACCEPTED' ? 'disabled style="opacity:0.5;"' : '' %>>
          Accept Candidate
        </button>
      </form>

      <form action="/applications/<%= application.id %>/status" method="POST" style="display: inline;">
        <input type="hidden" name="status" value="REJECTED">
        <button type="submit" class="btn btn-outline btn-sm" style="border-color: #f87171; color: #f87171;" <%= application.status === 'REJECTED' ? 'disabled style="opacity:0.5;"' : '' %>>
          Reject Application
        </button>
      </form>

      <form action="/applications/<%= application.id %>/status" method="POST" style="display: inline;">
        <input type="hidden" name="status" value="WITHDRAWN">
        <button type="submit" class="btn btn-outline btn-sm" style="color: var(--text-muted);" <%= application.status === 'WITHDRAWN' ? 'disabled style="opacity:0.5;"' : '' %>>
          Mark Withdrawn
        </button>
      </form>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
    <!-- Applicant Card -->
    <div class="card">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px;">
        <h3 style="font-size: 1.1rem; color: white;">Candidate Details</h3>
        <span class="badge badge-alumni">Applicant</span>
      </div>
      <% if (application.applicant) { %>
        <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem;">
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Full Name</span>
            <a href="/users/<%= application.applicant.id %>" style="color: white; font-weight: 600; font-size: 1.05rem; text-decoration: none;">
              <%= application.applicant.first_name %> <%= application.applicant.last_name %>
            </a>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Email Address</span>
            <span style="color: #38bdf8;"><%= application.applicant.email %></span>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Department & Role</span>
            <span style="color: white;"><%= application.applicant.role %> &bull; <%= application.applicant.department || application.applicant.department_name || 'N/A' %></span>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Graduation Year</span>
            <span style="color: white;"><%= application.applicant.graduation_year || 'N/A' %></span>
          </div>
          <div style="margin-top: 8px;">
            <a href="/users/<%= application.applicant.id %>" class="btn btn-outline btn-sm">View Candidate Profile &rarr;</a>
          </div>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted);">User ID: <%= application.user_id %></p>
      <% } %>
    </div>

    <!-- Job Card -->
    <div class="card">
      <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 12px; margin-bottom: 16px;">
        <h3 style="font-size: 1.1rem; color: white;">Job Vacancy</h3>
        <span class="badge badge-career">Position</span>
      </div>
      <% if (application.job_posting) { %>
        <div style="display: flex; flex-direction: column; gap: 12px; font-size: 0.9rem;">
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Position Title</span>
            <a href="/jobs/<%= application.job_posting.id %>" style="color: white; font-weight: 600; font-size: 1.05rem; text-decoration: none;">
              <%= application.job_posting.title %>
            </a>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Company & Location</span>
            <span style="color: white;"><%= application.job_posting.company %> &bull; <%= application.job_posting.location %></span>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Employment Type</span>
            <span class="badge badge-career"><%= application.job_posting.employment_type %></span>
          </div>
          <div>
            <span style="color: var(--text-muted); display: block; font-size: 0.8rem; text-transform: uppercase;">Salary Range</span>
            <span style="color: #38bdf8; font-family: monospace;"><%= application.job_posting.salary_range || 'Competitive' %></span>
          </div>
          <div style="margin-top: 8px;">
            <a href="/jobs/<%= application.job_posting.id %>" class="btn btn-outline btn-sm">View Full Job Description &rarr;</a>
          </div>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted);">Job ID: <%= application.job_posting_id %></p>
      <% } %>
    </div>
  </div>

  <!-- Application Materials Card -->
  <div class="card" style="margin-bottom: 24px;">
    <h3 style="font-size: 1.15rem; color: white; margin-bottom: 16px; border-bottom: 1px solid var(--border); padding-bottom: 12px;">
      Application Materials & Documents
    </h3>

    <div style="margin-bottom: 24px;">
      <h4 style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Curriculum Vitae / Resume</h4>
      <% if (application.resume_url) { %>
        <div style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <a href="<%= application.resume_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">
            &UpperRightArrow; Open Resume PDF (<%= application.resume_url %>)
          </a>
        </div>
      <% } else { %>
        <span style="color: var(--text-muted); font-style: italic;">No resume URL attached to this application.</span>
      <% } %>
    </div>

    <div>
      <h4 style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.05em;">Cover Letter / Motivation Statement</h4>
      <div style="background: rgba(15, 23, 42, 0.6); padding: 18px; border-radius: 8px; border: 1px solid var(--border); color: #e2e8f0; font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap;">
        <%= application.cover_letter || 'No cover letter was submitted with this application.' %>
      </div>
    </div>
  </div>

  <div style="display: flex; justify-content: space-between;">
    <a href="/applications" class="btn btn-outline btn-sm">&larr; Back to All Applications</a>
    <a href="/applications/<%= application.id %>/edit" class="btn btn-outline btn-sm">Edit Candidate Details</a>
  </div>
</div>

<%- include('../partials/footer') %>

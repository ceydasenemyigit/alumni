<%- include('../partials/header') %>

<div style="max-width: 520px; margin: 30px auto; padding-bottom: 50px;">
  <div style="text-align: center; margin-bottom: 30px;">
    <span class="badge badge-alumni" style="font-size: 0.8rem; padding: 6px 14px; margin-bottom: 12px;">
      🎓 SECURE ACCESS
    </span>
    <h1 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; color: white; margin-bottom: 8px;">
      Welcome Back
    </h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
      Sign in with your verified institutional or personal alumni credentials.
    </p>
  </div>

  <% if (typeof logged_out !== 'undefined' && logged_out) { %>
    <div style="background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.4); color: #7dd3fc; padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
      <span style="font-size: 1.2rem;">🔒</span>
      <span>You have been signed out safely. Come back anytime!</span>
    </div>
  <% } %>

  <% if (typeof registered !== 'undefined' && registered) { %>
    <div style="background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; padding: 14px 18px; border-radius: 12px; margin-bottom: 24px; font-size: 0.9rem; display: flex; align-items: center; gap: 10px;">
      <span>🎉</span>
      <span>Your account was created successfully! Please sign in below.</span>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert-error" style="margin-bottom: 24px;">
      <span style="font-size: 1.2rem;">⚠️</span>
      <div><%= error %></div>
    </div>
  <% } %>

  <div class="card" style="box-shadow: var(--shadow-apple); padding: 32px 28px;">
    <form action="/login" method="POST">
      <% if (typeof redirect !== 'undefined' && redirect) { %>
        <input type="hidden" name="redirect" value="<%= redirect %>">
      <% } %>

      <div class="form-group">
        <label class="form-label" for="loginEmail">Email Address</label>
        <input
          type="email"
          id="loginEmail"
          name="email"
          placeholder="your.email@alumni.istanbul.edu.tr"
          required
          class="form-control"
        >
      </div>

      <div class="form-group" style="margin-bottom: 24px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="loginPassword" style="margin-bottom: 0;">Password</label>
          <a href="#" style="font-size: 0.8rem; color: var(--primary-on-dark); text-decoration: none;">Forgot password?</a>
        </div>
        <div style="position: relative;">
          <input
            type="password"
            id="loginPassword"
            name="password"
            placeholder="••••••••"
            required
            class="form-control"
            style="padding-right: 42px;"
          >
          <button type="button" id="toggleLoginPassword" style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.9rem;">
            👁️
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-pill btn-pill-primary" style="width: 100%; padding: 12px; font-size: 0.95rem; margin-bottom: 18px;">
        Sign In &rarr;
      </button>

      <!-- Quick Demo Credentials Hint Box -->
      <div style="background: rgba(20, 12, 23, 0.6); border: 1px dashed var(--border-subtle); border-radius: 12px; padding: 12px 14px; margin-bottom: 18px; font-size: 0.8rem; color: var(--text-soft);">
        <strong style="color: white; display: block; margin-bottom: 4px;">💡 Demo Accounts:</strong>
        <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px;">
          <button type="button" onclick="fillDemo('emre@example.com', 'password')" class="btn btn-utility btn-sm" style="font-size: 0.76rem; padding: 4px 10px;">
            Alumni: Emre Yılmaz
          </button>
          <button type="button" onclick="fillDemo('ceyda@example.com', 'password')" class="btn btn-utility btn-sm" style="font-size: 0.76rem; padding: 4px 10px;">
            Alumni: Ceyda Şenyiğit
          </button>
        </div>
      </div>

      <div style="text-align: center; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, 0.08); font-size: 0.88rem; color: var(--text-muted);">
        Don't have an account yet?
        <a href="/register" style="color: var(--primary-on-dark); font-weight: 700; text-decoration: none;">
          Register Now &rarr;
        </a>
      </div>
    </form>
  </div>
</div>

<script>
  const toggleBtn = document.getElementById('toggleLoginPassword');
  const passInput = document.getElementById('loginPassword');
  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', () => {
      const isPass = passInput.type === 'password';
      passInput.type = isPass ? 'text' : 'password';
      toggleBtn.textContent = isPass ? '🔒' : '👁️';
    });
  }

  function fillDemo(email, pass) {
    document.getElementById('loginEmail').value = email;
    document.getElementById('loginPassword').value = pass;
  }
</script>

<%- include('../partials/footer') %>

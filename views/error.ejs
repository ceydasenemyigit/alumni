<%- include('partials/header') %>

<div style="max-width: 580px; margin: 60px auto; text-align: center;">
  <div class="card" style="padding: 48px 36px; border: 1px solid rgba(239, 68, 68, 0.25);">
    <div style="font-size: 3rem; margin-bottom: 16px;">⚠️</div>
    <div style="display: inline-block; padding: 4px 14px; border-radius: 9999px; background: rgba(239, 68, 68, 0.15); color: #fca5a5; font-size: 0.85rem; font-weight: 700; margin-bottom: 12px;">
      <%= typeof status !== 'undefined' ? status : 500 %> ERROR
    </div>
    <h1 style="font-size: 1.75rem; color: white; margin-bottom: 12px;">
      <%= typeof title !== 'undefined' ? title : 'Error Occurred' %>
    </h1>
    <p style="color: var(--text-muted); font-size: 1rem; line-height: 1.6; margin-bottom: 20px;">
      <%= typeof message !== 'undefined' ? message : 'The requested resource could not be found or an unexpected error occurred.' %>
    </p>

    <% if (typeof reason !== 'undefined' && reason) { %>
      <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 8px; padding: 12px 16px; margin-bottom: 24px; text-align: left;">
        <span style="color: #94a3b8; font-size: 0.85rem; font-weight: 600; text-transform: uppercase;">Reason:</span>
        <div style="color: #fca5a5; font-size: 0.95rem; margin-top: 4px;"><%= reason %></div>
      </div>
    <% } %>

    <div style="display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;">
      <a href="/" class="btn btn-primary">&larr; Home</a>
      <a href="/users" class="btn btn-outline">Users Directory</a>
      <a href="/jobs" class="btn btn-outline">Job Board</a>
    </div>
  </div>
</div>

<%- include('partials/footer') %>

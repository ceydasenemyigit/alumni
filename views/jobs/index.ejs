<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Career Opportunities & Job Board</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 4px;">Explore vacancies, summer internships, and tech roles posted by alumni and partner companies.</p>
  </div>
  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
    <a href="/applications" class="btn btn-outline">Browse Applications</a>
    <a href="/jobs/new" class="btn btn-primary">+ Post New Job</a>
  </div>
</div>

<% if (typeof stats !== 'undefined' && stats) { %>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="card" style="padding: 16px 20px;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Total Job Listings</div>
      <div style="font-size: 1.8rem; font-weight: 700; color: white; margin-top: 4px;"><%= stats.totalJobs %></div>
    </div>
    <div class="card" style="padding: 16px 20px;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Active Openings</div>
      <div style="font-size: 1.8rem; font-weight: 700; color: #34d399; margin-top: 4px;"><%= stats.activeJobs %></div>
    </div>
    <div class="card" style="padding: 16px 20px;">
      <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em;">Total Candidacies Received</div>
      <div style="font-size: 1.8rem; font-weight: 700; color: #38bdf8; margin-top: 4px;"><%= stats.totalApplications %></div>
    </div>
  </div>
<% } %>

<div class="card" style="margin-bottom: 24px;">
  <form action="/jobs" method="GET" style="display: flex; gap: 12px; flex-wrap: wrap; align-items: center;">
    <input
      type="text"
      name="search"
      value="<%= query && query.search ? query.search : '' %>"
      placeholder="Search by title, company, or keywords..."
      style="flex: 1; min-width: 240px; padding: 10px 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 8px; color: white; font-size: 0.9rem;"
    >
    <select name="employment_type" style="padding: 10px 14px; background: rgba(15, 23, 42, 0.6); border: 1px solid var(--border); border-radius: 8px; color: white; font-size: 0.9rem;">
      <option value="">All Employment Types</option>
      <option value="Full-Time" <%= query && query.employment_type === 'Full-Time' ? 'selected' : '' %>>Full-Time</option>
      <option value="Part-Time" <%= query && query.employment_type === 'Part-Time' ? 'selected' : '' %>>Part-Time</option>
      <option value="Contract" <%= query && query.employment_type === 'Contract' ? 'selected' : '' %>>Contract</option>
      <option value="Internship" <%= query && query.employment_type === 'Internship' ? 'selected' : '' %>>Internship</option>
      <option value="Remote" <%= query && query.employment_type === 'Remote' ? 'selected' : '' %>>Remote</option>
    </select>
    <button type="submit" class="btn btn-outline">Filter Jobs</button>
    <% if (query && (query.search || query.employment_type)) { %>
      <a href="/jobs" class="btn btn-outline" style="color: var(--text-muted);">Reset Filter</a>
    <% } %>
  </form>
</div>

<div class="card" style="padding: 0; overflow: hidden;">
  <% if (!jobs || jobs.length === 0) { %>
    <div style="padding: 48px 24px; text-align: center; color: var(--text-muted);">
      <p style="font-size: 1.1rem; margin-bottom: 12px;">No job postings found matching your search.</p>
      <a href="/jobs/new" class="btn btn-primary btn-sm">+ Post the first job vacancy</a>
    </div>
  <% } else { %>
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
      <thead>
        <tr style="border-bottom: 1px solid var(--border); background: rgba(15, 23, 42, 0.4); color: var(--text-muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">
          <th style="padding: 14px 20px;">Position / Company</th>
          <th style="padding: 14px 20px;">Type</th>
          <th style="padding: 14px 20px;">Location</th>
          <th style="padding: 14px 20px;">Salary Range</th>
          <th style="padding: 14px 20px;">Applicants</th>
          <th style="padding: 14px 20px; text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach(job => { %>
          <tr style="border-bottom: 1px solid rgba(51, 65, 85, 0.4); transition: background 0.15s;" onmouseover="this.style.background='rgba(51,65,85,0.2)'" onmouseout="this.style.background='transparent'">
            <td style="padding: 16px 20px;">
              <a href="/jobs/<%= job.id %>" style="color: white; text-decoration: none; font-weight: 600; font-size: 0.95rem; display: block;">
                <%= job.title %>
              </a>
              <span style="color: var(--text-muted); font-size: 0.85rem;"><%= job.company %></span>
            </td>
            <td style="padding: 16px 20px;">
              <span class="badge badge-career"><%= job.employment_type %></span>
            </td>
            <td style="padding: 16px 20px; color: var(--text-muted);">
              <%= job.location %>
            </td>
            <td style="padding: 16px 20px; color: #38bdf8; font-family: monospace;">
              <%= job.salary_range || 'Competitive' %>
            </td>
            <td style="padding: 16px 20px;">
              <a href="/jobs/<%= job.id %>#applicants" style="text-decoration: none;">
                <span class="badge <%= (job.applicationCount && job.applicationCount > 0) ? 'badge-student' : 'badge-general' %>">
                  <%= (typeof job.applicationCount !== 'undefined') ? job.applicationCount : 0 %> candidates
                </span>
              </a>
            </td>
            <td style="padding: 16px 20px; text-align: right;">
              <div style="display: inline-flex; gap: 8px;">
                <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-primary btn-sm">Apply</a>
                <a href="/jobs/<%= job.id %>" class="btn btn-outline btn-sm">View</a>
                <a href="/jobs/<%= job.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
                <form action="/jobs/<%= job.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job posting?');">
                  <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>

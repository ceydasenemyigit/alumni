<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Career Opportunities & Job Board</h1>
    <p class="page-subtitle">Discover high-impact vacancies, summer internships, and leadership roles posted by university alumni network.</p>
  </div>
  <div style="display: flex; gap: 12px; flex-wrap: wrap;">
    <a href="/applications" class="btn btn-utility">Application Pipeline &rarr;</a>
    <a href="/jobs/new" class="btn btn-pill btn-pill-primary">+ Post a Vacancy</a>
  </div>
</div>

<% if (typeof stats !== 'undefined' && stats) { %>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Total Job Listings</div>
      <div class="stat-value"><%= stats.totalJobs %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Active Openings</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #6ee7b7, #10b981); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.activeJobs %></div>
    </div>
    <div class="stat-card">
      <div class="stat-label">Total Applications Submitted</div>
      <div class="stat-value" style="background: linear-gradient(135deg, #fda4af, #f43f5e); -webkit-background-clip: text; -webkit-text-fill-color: transparent;"><%= stats.totalApplications %></div>
    </div>
  </div>
<% } %>

<!-- Search & Type Filter Bar -->
<div class="card" style="margin-bottom: 28px; padding: 18px 24px;">
  <form action="/jobs" method="GET" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
    <div style="flex: 1; min-width: 260px; position: relative;">
      <input
        type="text"
        name="search"
        value="<%= query && query.search ? query.search : '' %>"
        placeholder="Search jobs by title, company, or keywords..."
        class="form-control"
        style="padding-left: 42px;"
      >
      <span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-soft); font-size: 1.05rem;">💼</span>
    </div>
    <select name="employment_type" class="form-control" style="width: auto; min-width: 180px;">
      <option value="">All Employment Types</option>
      <option value="Full-Time" <%= query && query.employment_type === 'Full-Time' ? 'selected' : '' %>>Full-Time</option>
      <option value="Part-Time" <%= query && query.employment_type === 'Part-Time' ? 'selected' : '' %>>Part-Time</option>
      <option value="Contract" <%= query && query.employment_type === 'Contract' ? 'selected' : '' %>>Contract</option>
      <option value="Internship" <%= query && query.employment_type === 'Internship' ? 'selected' : '' %>>Internship</option>
      <option value="Remote" <%= query && query.employment_type === 'Remote' ? 'selected' : '' %>>Remote</option>
    </select>
    <button type="submit" class="btn btn-utility">Filter Openings</button>
    <% if (query && (query.search || query.employment_type)) { %>
      <a href="/jobs" class="btn btn-utility" style="color: var(--text-soft);">Reset</a>
    <% } %>
  </form>
</div>

<!-- Jobs Data Table -->
<div class="table-container">
  <% if (!jobs || jobs.length === 0) { %>
    <div style="padding: 64px 24px; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 12px; opacity: 0.7;">💼</div>
      <h3 style="color: white; font-size: 1.3rem; margin-bottom: 6px;">No Job Openings Available</h3>
      <p style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text-soft);">Be the first alumni to post a vacancy for fellow graduates.</p>
      <a href="/jobs/new" class="btn btn-pill btn-pill-primary btn-sm">+ Post Job Vacancy</a>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Position & Company</th>
          <th>Type</th>
          <th>Location</th>
          <th>Compensation</th>
          <th>Candidacies</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach(job => { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(244, 63, 94, 0.15); border: 1px solid rgba(244, 63, 94, 0.3); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
                  🏢
                </div>
                <div>
                  <a href="/jobs/<%= job.id %>" style="color: white; font-weight: 700; text-decoration: none; font-size: 1rem; display: block; transition: color 0.2s;" onmouseover="this.style.color='#fda4af'" onmouseout="this.style.color='white'">
                    <%= job.title %>
                  </a>
                  <span style="color: var(--text-muted); font-size: 0.85rem;"><%= job.company %></span>
                </div>
              </div>
            </td>
            <td>
              <span class="badge badge-career"><%= job.employment_type %></span>
            </td>
            <td>
              <span style="color: var(--text-muted); font-size: 0.9rem;">📍 <%= job.location || 'Remote' %></span>
            </td>
            <td>
              <span style="color: #6ee7b7; font-family: 'JetBrains Mono', monospace; font-weight: 600; font-size: 0.88rem;">
                <%= job.salary_range || 'Competitive' %>
              </span>
            </td>
            <td>
              <a href="/jobs/<%= job.id %>#applicants" style="text-decoration: none;">
                <span class="badge <%= (job.applicationCount && job.applicationCount > 0) ? 'badge-student' : 'badge-general' %>">
                  <%= (typeof job.applicationCount !== 'undefined') ? job.applicationCount : 0 %> applicants
                </span>
              </a>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px; align-items: center;">
                <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-pill btn-pill-primary" style="padding: 5px 14px; font-size: 0.8rem;">Apply &rarr;</a>
                <a href="/jobs/<%= job.id %>" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">View</a>
                <a href="/jobs/<%= job.id %>/edit" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Edit</a>
                <form action="/jobs/<%= job.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job vacancy?');">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>

<%- include('../partials/header') %>

<div style="max-width: 920px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
        <span class="badge badge-career"><%= job.employment_type %></span>
        <% if (job.is_active) { %>
          <span class="badge badge-accepted">● Active Vacancy</span>
        <% } else { %>
          <span class="badge badge-withdrawn">○ Closed</span>
        <% } %>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text-soft);">REF #JOB-<%= job.id %></span>
      </div>
      <h1 class="page-title"><%= job.title %></h1>
      <p style="color: var(--primary-on-dark); font-size: 1.15rem; font-weight: 700; margin-top: 6px;">
        🏢 <%= job.company %> &bull; 📍 <%= job.location || 'Remote' %>
      </p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
      <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-pill btn-pill-primary">+ Apply for Position</a>
      <a href="/jobs/<%= job.id %>/edit" class="btn btn-utility">Edit</a>
      <form action="/jobs/<%= job.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to permanently delete this job posting?');">
        <button type="submit" class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>

  <!-- Requisition Hero Card with Apple soft drop shadow -->
  <div class="card" style="box-shadow: var(--shadow-apple); margin-bottom: 28px;">
    <!-- Specs Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; padding-bottom: 24px; border-bottom: 1px solid rgba(244, 63, 94, 0.2); margin-bottom: 24px;">
      <div style="background: rgba(20, 12, 23, 0.5); padding: 14px 18px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
        <div style="font-size: 0.74rem; color: var(--text-soft); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em;">Compensation Package</div>
        <div style="font-size: 1.15rem; font-weight: 700; color: #6ee7b7; margin-top: 4px; font-family: 'JetBrains Mono', monospace;"><%= job.salary_range || 'Competitive / Undisclosed' %></div>
      </div>
      <div style="background: rgba(20, 12, 23, 0.5); padding: 14px 18px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
        <div style="font-size: 0.74rem; color: var(--text-soft); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em;">Workplace Location</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: white; margin-top: 4px;"><%= job.location || 'Remote / Hybrid' %></div>
      </div>
      <div style="background: rgba(20, 12, 23, 0.5); padding: 14px 18px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, 0.05);">
        <div style="font-size: 0.74rem; color: var(--text-soft); text-transform: uppercase; font-weight: 700; letter-spacing: 0.06em;">Published On</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: white; margin-top: 4px;"><%= new Date(job.created_at).toLocaleDateString() %></div>
      </div>
    </div>

    <!-- Job Description -->
    <div style="margin-bottom: 28px;">
      <h3 style="color: white; margin-bottom: 12px; font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em;">Position Overview</h3>
      <div style="color: var(--text-muted); font-size: 1rem; line-height: 1.7; white-space: pre-wrap;">
<%= job.description %>
      </div>
    </div>

    <!-- Requirements -->
    <% if (job.requirements) { %>
      <div style="margin-bottom: 28px; background: rgba(20, 12, 23, 0.4); padding: 20px 24px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, 0.06);">
        <h3 style="color: var(--primary-on-dark); margin-bottom: 12px; font-size: 1.1rem; font-weight: 700;">Candidate Qualifications & Skills</h3>
        <div style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; white-space: pre-wrap;">
<%= job.requirements %>
        </div>
      </div>
    <% } %>

    <!-- Call to action block -->
    <div style="padding-top: 24px; border-top: 1px solid rgba(244, 63, 94, 0.2); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
      <div>
        <div style="font-size: 0.85rem; color: var(--text-soft);">Ready to take the next step in your career?</div>
        <div style="color: white; font-weight: 700; font-size: 1.05rem;">Submit your candidate application directly to the alumni hiring team.</div>
      </div>
      <div style="display: flex; gap: 12px; align-items: center;">
        <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-pill btn-pill-primary">Apply on Platform &rarr;</a>
        <% if (job.application_url) { %>
          <a href="<%= job.application_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-utility">External Link ↗</a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Poster Info Card -->
  <% if (poster) { %>
    <div class="card" style="display: flex; align-items: center; justify-content: space-between; gap: 18px; margin-bottom: 28px; flex-wrap: wrap;">
      <div style="display: flex; align-items: center; gap: 16px;">
        <div style="width: 50px; height: 50px; border-radius: 9999px; background: linear-gradient(135deg, rgba(244, 63, 94, 0.3), rgba(236, 72, 153, 0.4)); border: 2px solid rgba(244, 63, 94, 0.45); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; color: white;">
          <%= poster.first_name ? poster.first_name[0].toUpperCase() : 'U' %>
        </div>
        <div>
          <div style="font-size: 0.74rem; color: var(--text-soft); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Opportunity Published By</div>
          <a href="/users/<%= poster.id %>" style="color: white; text-decoration: none; font-weight: 700; font-size: 1.05rem;">
            <%= poster.first_name %> <%= poster.last_name %>
          </a>
          <span class="badge badge-<%= (poster.role || 'alumni').toLowerCase() %>" style="margin-left: 6px;"><%= poster.role %></span>
          <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 2px;"><%= poster.email %> &bull; <%= poster.department || poster.department_name || 'Alumni Network' %></div>
        </div>
      </div>
      <a href="/users/<%= poster.id %>" class="btn btn-utility btn-sm">View Alumni Profile &rarr;</a>
    </div>
  <% } %>

  <!-- Candidates / Applications List for this Job -->
  <div class="card" id="applicants" style="margin-bottom: 28px;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(244, 63, 94, 0.2); padding-bottom: 16px; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
      <div>
        <h3 style="color: white; font-size: 1.2rem; font-weight: 700; display: flex; align-items: center; gap: 10px;">
          <span>Received Candidacies</span>
          <span class="badge badge-career"><%= (typeof applications !== 'undefined' && applications) ? applications.length : 0 %></span>
        </h3>
        <p style="color: var(--text-soft); font-size: 0.88rem; margin-top: 2px;">Candidates matching this job vacancy through the N:M application system.</p>
      </div>
      <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-utility btn-sm">+ Register Candidate</a>
    </div>

    <% if (!applications || applications.length === 0) { %>
      <div style="text-align: center; padding: 48px 16px; color: var(--text-muted);">
        <div style="font-size: 2.2rem; margin-bottom: 8px;">📬</div>
        <p style="font-size: 0.98rem; margin-bottom: 14px; color: var(--text-soft);">No applications submitted for this vacancy yet.</p>
        <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-pill btn-pill-primary btn-sm">Be the first applicant</a>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 12px;">
        <% applications.forEach(app => { %>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px 18px; background: rgba(20, 12, 23, 0.6); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 12px; flex-wrap: wrap; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 14px;">
              <div style="width: 40px; height: 40px; border-radius: 9999px; background: rgba(244, 63, 94, 0.2); border: 1px solid rgba(244, 63, 94, 0.35); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; font-size: 0.9rem;">
                <%= app.applicant ? (app.applicant.first_name[0] + (app.applicant.last_name ? app.applicant.last_name[0] : '')) : '#' %>
              </div>
              <div>
                <a href="/users/<%= app.user_id %>" style="color: white; font-weight: 700; text-decoration: none; font-size: 0.98rem;">
                  <%= app.applicant ? (app.applicant.first_name + ' ' + app.applicant.last_name) : ('Candidate #' + app.user_id) %>
                </a>
                <div style="font-size: 0.82rem; color: var(--text-muted);">
                  <%= app.applicant ? app.applicant.email : '' %> &bull; Applied: <%= new Date(app.applied_at).toLocaleDateString() %>
                </div>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 12px;">
              <span class="badge badge-<%= (app.status || 'pending').toLowerCase() %>"><%= app.status %></span>
              <a href="/applications/<%= app.id %>" class="btn btn-utility btn-sm">Review Candidacy &rarr;</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div style="display: flex; justify-content: space-between; align-items: center;">
    <a href="/jobs" class="btn btn-utility">&larr; Back to Job Board</a>
    <a href="/applications" class="btn btn-utility">All Applications Pipeline &rarr;</a>
  </div>
</div>

<%- include('../partials/footer') %>

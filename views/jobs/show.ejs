<%- include('../partials/header') %>

<div style="max-width: 860px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 8px;">
        <span class="badge badge-career"><%= job.employment_type %></span>
        <% if (job.is_active) { %>
          <span class="badge badge-accepted">Active</span>
        <% } else { %>
          <span class="badge badge-withdrawn">Closed</span>
        <% } %>
      </div>
      <h1 class="page-title"><%= job.title %></h1>
      <p style="color: #38bdf8; font-size: 1.1rem; font-weight: 600; margin-top: 4px;"><%= job.company %> • <%= job.location %></p>
    </div>
    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
      <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-primary btn-sm">+ Apply Now</a>
      <a href="/jobs/<%= job.id %>/edit" class="btn btn-outline btn-sm">Edit</a>
      <form action="/jobs/<%= job.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this job posting?');">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  </div>

  <div class="card" style="margin-bottom: 24px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--border); margin-bottom: 20px;">
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Salary Range</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: #38bdf8; margin-top: 4px; font-family: monospace;"><%= job.salary_range || 'Competitive' %></div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Location</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: white; margin-top: 4px;"><%= job.location %></div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Application Deadline</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: white; margin-top: 4px;"><%= job.deadline || 'Open until filled' %></div>
      </div>
      <div>
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Posted Date</div>
        <div style="font-size: 1.05rem; font-weight: 600; color: white; margin-top: 4px;"><%= new Date(job.created_at).toLocaleDateString() %></div>
      </div>
    </div>

    <h3 style="color: white; margin-bottom: 12px; font-size: 1.1rem;">Role Description</h3>
    <div style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; margin-bottom: 24px;">
      <%= job.description %>
    </div>

    <% if (job.requirements) { %>
      <h3 style="color: white; margin-bottom: 12px; font-size: 1.1rem;">Requirements & Skills</h3>
      <div style="color: #cbd5e1; font-size: 0.95rem; line-height: 1.6; white-space: pre-wrap; margin-bottom: 24px;">
        <%= job.requirements %>
      </div>
    <% } %>

    <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
      <div>
        <div style="font-size: 0.85rem; color: var(--text-muted);">Ready to submit your application?</div>
        <div style="color: white; font-weight: 600;">Apply directly on the platform or through company career portal</div>
      </div>
      <div style="display: flex; gap: 10px;">
        <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-primary">Apply on Platform &rarr;</a>
        <% if (job.application_url) { %>
          <a href="<%= job.application_url %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline">External Link &UpperRightArrow;</a>
        <% } %>
      </div>
    </div>
  </div>

  <% if (poster) { %>
    <div class="card" style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px;">
      <div style="width: 48px; height: 48px; border-radius: 50%; background: #2563eb; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.2rem; color: white;">
        <%= poster.first_name ? poster.first_name[0] : 'U' %>
      </div>
      <div style="flex: 1;">
        <div style="font-size: 0.8rem; color: var(--text-muted); text-transform: uppercase;">Opportunity Posted By</div>
        <a href="/users/<%= poster.id %>" style="color: white; text-decoration: none; font-weight: 600;">
          <%= poster.first_name %> <%= poster.last_name %> (<%= poster.role %>)
        </a>
        <div style="font-size: 0.85rem; color: var(--text-muted);"><%= poster.email %> &bull; <%= poster.department || poster.department_name || '' %></div>
      </div>
      <a href="/users/<%= poster.id %>" class="btn btn-outline btn-sm">View Profile</a>
    </div>
  <% } %>

  <!-- Candidates / Applications List for this Job -->
  <div class="card" id="applicants" style="margin-bottom: 24px;">
    <div style="display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--border); padding-bottom: 14px; margin-bottom: 16px;">
      <div>
        <h3 style="color: white; font-size: 1.15rem; display: flex; align-items: center; gap: 10px;">
          <span>Received Applications</span>
          <span class="badge badge-career"><%= (typeof applications !== 'undefined' && applications) ? applications.length : 0 %></span>
        </h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 2px;">Candidates who applied for this vacancy through the platform.</p>
      </div>
      <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-outline btn-sm">+ Add Candidate</a>
    </div>

    <% if (!applications || applications.length === 0) { %>
      <div style="text-align: center; padding: 32px 16px; color: var(--text-muted);">
        <p style="font-size: 0.95rem; margin-bottom: 12px;">No applications submitted for this vacancy yet.</p>
        <a href="/applications/new?job_id=<%= job.id %>" class="btn btn-primary btn-sm">Be the first applicant</a>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% applications.forEach(app => { %>
          <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; background: rgba(15, 23, 42, 0.4); border: 1px solid var(--border); border-radius: 8px; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; align-items: center; gap: 12px;">
              <div style="width: 38px; height: 38px; border-radius: 50%; background: #334155; display: flex; align-items: center; justify-content: center; font-weight: 600; color: white; font-size: 0.9rem;">
                <%= app.applicant ? (app.applicant.first_name[0] + app.applicant.last_name[0]) : '#' %>
              </div>
              <div>
                <a href="/users/<%= app.user_id %>" style="color: white; font-weight: 600; text-decoration: none;">
                  <%= app.applicant ? (app.applicant.first_name + ' ' + app.applicant.last_name) : ('Candidate #' + app.user_id) %>
                </a>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                  <%= app.applicant ? app.applicant.email : '' %> &bull; Applied: <%= new Date(app.applied_at).toLocaleDateString() %>
                </div>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <span class="badge badge-<%= app.status.toLowerCase() %>"><%= app.status %></span>
              <a href="/applications/<%= app.id %>" class="btn btn-outline btn-sm">Review Application</a>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <div style="margin-top: 24px; display: flex; justify-content: space-between;">
    <a href="/jobs" class="btn btn-outline btn-sm">&larr; Back to Job Board</a>
    <a href="/applications" class="btn btn-outline btn-sm">All Applications &rarr;</a>
  </div>
</div>

<%- include('../partials/footer') %>

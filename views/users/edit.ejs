<%- include('../partials/header') %>

<div style="max-width: 680px; margin: 0 auto;">
  <div class="page-header">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 8px; margin-bottom: 6px;">
        <span class="badge badge-<%= (user.role || 'alumni').toLowerCase() %>"><%= user.role %></span>
        <span style="font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--text-soft);">ID #<%= user.id %></span>
      </div>
      <h1 class="page-title">Edit User #<%= user.id %></h1>
      <p class="page-subtitle">Update account details, role clearance, or academic faculty for <%= user.first_name %> <%= user.last_name %>.</p>
    </div>
    <a href="/users/<%= user.id %>" class="btn btn-utility">&larr; Profile</a>
  </div>

  <% if (error) { %>
    <div class="alert-error">
      <span style="font-size: 1.2rem;">⚠️</span>
      <div>
        <strong>Update Error:</strong> <%= error %>
      </div>
    </div>
  <% } %>

  <div class="card" style="box-shadow: var(--shadow-apple);">
    <form action="/users/<%= user.id %>" method="POST">
      <input type="hidden" name="_method" value="PUT">

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group">
          <label class="form-label">First Name *</label>
          <input
            type="text"
            name="first_name"
            value="<%= user.first_name || '' %>"
            required
            class="form-control"
          >
        </div>
        <div class="form-group">
          <label class="form-label">Last Name</label>
          <input
            type="text"
            name="last_name"
            value="<%= user.last_name || '' %>"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email Address *</label>
        <input
          type="email"
          name="email"
          value="<%= user.email || '' %>"
          required
          class="form-control"
        >
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div class="form-group">
          <label class="form-label">System Role</label>
          <select name="role" class="form-control">
            <option value="ALUMNI" <%= user.role === 'ALUMNI' ? 'selected' : '' %>>🎓 Alumni Graduate</option>
            <option value="STUDENT" <%= user.role === 'STUDENT' ? 'selected' : '' %>>🎒 Undergraduate Student</option>
            <option value="ADMIN" <%= user.role === 'ADMIN' ? 'selected' : '' %>>🛡️ Portal Administrator</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Graduation Year</label>
          <input
            type="number"
            name="graduation_year"
            value="<%= user.graduation_year || '' %>"
            min="1950"
            max="2035"
            class="form-control"
          >
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Department / Faculty Name</label>
        <input
          type="text"
          name="department"
          value="<%= user.department || '' %>"
          class="form-control"
        >
      </div>

      <div style="margin-top: 24px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.08); display: flex; gap: 12px; justify-content: flex-end; align-items: center;">
        <a href="/users/<%= user.id %>" class="btn btn-utility">Cancel</a>
        <button type="submit" class="btn btn-pill btn-pill-primary">Save Changes &rarr;</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>

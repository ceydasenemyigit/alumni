<%- include('../partials/header') %>

<div class="page-header">
  <div>
    <h1 class="page-title">Alumni User Directory</h1>
    <p class="page-subtitle">Search, discover, and connect with graduates, undergraduate researchers, and academic faculty.</p>
  </div>
  <a href="/users/new" class="btn btn-pill btn-pill-primary">+ Add New Profile</a>
</div>

<!-- Search & Filters Utility Card -->
<div class="card" style="margin-bottom: 28px; padding: 18px 24px;">
  <form action="/users" method="GET" style="display: flex; gap: 14px; flex-wrap: wrap; align-items: center;">
    <div style="flex: 1; min-width: 260px; position: relative;">
      <input
        type="text"
        name="search"
        value="<%= search %>"
        placeholder="Search alumni by name, email, department..."
        class="form-control"
        style="padding-left: 42px;"
      >
      <span style="position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--text-soft); font-size: 1.05rem;">🔍</span>
    </div>
    <select name="role" class="form-control" style="width: auto; min-width: 160px;">
      <option value="">All Roles</option>
      <option value="ALUMNI" <%= activeRole === 'ALUMNI' ? 'selected' : '' %>>🎓 Alumni</option>
      <option value="STUDENT" <%= activeRole === 'STUDENT' ? 'selected' : '' %>>🎒 Student</option>
      <option value="ADMIN" <%= activeRole === 'ADMIN' ? 'selected' : '' %>>🛡️ Admin</option>
    </select>
    <button type="submit" class="btn btn-utility">Search Directory</button>
    <% if (search || activeRole) { %>
      <a href="/users" class="btn btn-utility" style="color: var(--text-soft);">Clear Filter</a>
    <% } %>
  </form>
</div>

<!-- User Directory Table & Grid -->
<div class="table-container">
  <% if (users.length === 0) { %>
    <div style="padding: 64px 24px; text-align: center; color: var(--text-muted);">
      <div style="font-size: 3rem; margin-bottom: 12px; opacity: 0.7;">👥</div>
      <h3 style="color: white; font-size: 1.3rem; margin-bottom: 6px;">No Matching Profiles Found</h3>
      <p style="font-size: 0.95rem; margin-bottom: 20px; color: var(--text-soft);">Try modifying your search criteria or register a new user.</p>
      <a href="/users/new" class="btn btn-pill btn-pill-primary btn-sm">+ Create Profile</a>
    </div>
  <% } else { %>
    <table class="data-table">
      <thead>
        <tr>
          <th>Candidate / Member</th>
          <th>Role</th>
          <th>Department & Faculty</th>
          <th>Grad Year</th>
          <th>Email Address</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(user => { %>
          <tr>
            <td>
              <div style="display: flex; align-items: center; gap: 14px;">
                <div style="width: 44px; height: 44px; border-radius: 9999px; background: linear-gradient(135deg, rgba(244, 63, 94, 0.25), rgba(236, 72, 153, 0.35)); border: 2px solid rgba(244, 63, 94, 0.4); display: flex; align-items: center; justify-content: center; font-weight: 700; color: white; font-size: 1rem; flex-shrink: 0; box-shadow: 0 2px 10px rgba(244, 63, 94, 0.2);">
                  <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'U' %><%= user.last_name ? user.last_name.charAt(0).toUpperCase() : '' %>
                </div>
                <div>
                  <a href="/users/<%= user.id %>" style="color: white; font-weight: 700; text-decoration: none; font-size: 1rem; display: block; transition: color 0.2s;" onmouseover="this.style.color='#fda4af'" onmouseout="this.style.color='white'">
                    <%= user.first_name %> <%= user.last_name %>
                  </a>
                  <span style="font-size: 0.78rem; color: var(--text-soft); font-family: 'JetBrains Mono', monospace;">ID #<%= user.id %></span>
                </div>
              </div>
            </td>
            <td>
              <span class="badge badge-<%= (user.role || 'alumni').toLowerCase() %>">
                <%= user.role %>
              </span>
            </td>
            <td>
              <div style="color: white; font-weight: 500;"><%= user.department || user.department_name || 'General Academic' %></div>
            </td>
            <td>
              <% if (user.graduation_year) { %>
                <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; background: rgba(255, 255, 255, 0.06); font-family: 'JetBrains Mono', monospace; font-size: 0.8rem; color: var(--primary-on-dark);">
                  🎓 <%= user.graduation_year %>
                </span>
              <% } else { %>
                <span style="color: var(--text-soft);">—</span>
              <% } %>
            </td>
            <td>
              <span style="color: var(--text-muted); font-size: 0.88rem;"><%= user.email %></span>
            </td>
            <td style="text-align: right;">
              <div style="display: inline-flex; gap: 8px; align-items: center;">
                <a href="/users/<%= user.id %>" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">View</a>
                <a href="/users/<%= user.id %>/edit" class="btn btn-utility" style="padding: 5px 12px; font-size: 0.8rem;">Edit</a>
                <form action="/users/<%= user.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete profile #<%= user.id %>?');">
                  <button type="submit" class="btn btn-danger">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/footer') %>
